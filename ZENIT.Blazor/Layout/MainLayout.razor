@inherits LayoutComponentBase
@using ZENIT.Blazor.Services
@inject PlayerStateService PlayerState
@inject FavoritesService Favorites
@implements IDisposable

<div class="flex h-screen w-full bg-[#09090b] text-white overflow-hidden relative">

    <!-- FONDO DINÁMICO INMERSIVO (Global) -->
    @if (PlayerState.CurrentStation != null)
    {
        <div class="absolute inset-0 z-0 pointer-events-none opacity-30 transition-opacity duration-1000">
            @if (!string.IsNullOrEmpty(PlayerState.CurrentStation.Favicon))
            {
                <div class="absolute inset-0 bg-cover bg-center blur-[120px] scale-110" style="background-image: url('@PlayerState.CurrentStation.Favicon')"></div>
            }
            else
            {
                <div class="absolute inset-0 bg-zenit-gradient blur-[120px] opacity-50"></div>
            }
        </div>
    }

    <!-- Capa para asegurar que el texto sea legible -->
    <div class="absolute inset-0 z-0 pointer-events-none bg-black/60"></div>

    <!-- SIDEBAR (Escritorio / >= lg) -->
    <aside class="hidden lg:flex flex-col w-64 h-full bg-black/40 backdrop-blur-md border-r border-white/5 z-10">
        <div class="flex items-center gap-3 px-6 py-8">
            <div class="w-10 h-10 rounded-xl bg-zenit-gradient flex items-center justify-center shadow-lg shadow-zenit-primary/20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11" />
                </svg>
            </div>
            <span class="text-3xl font-black tracking-tighter text-white drop-shadow-md">ZENIT</span>
        </div>

        <nav class="flex flex-col gap-2 px-4 mt-4">
            <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-gray-400 hover:text-white hover:bg-white/5 transition-colors" ActiveClass="bg-white/10 text-white font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                Inicio
            </NavLink>
            <NavLink href="buscar" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-gray-400 hover:text-white hover:bg-white/5 transition-colors" ActiveClass="bg-white/10 text-white font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                Buscar
            </NavLink>
            <NavLink href="favoritos" class="flex items-center gap-4 px-4 py-3 rounded-2xl text-gray-400 hover:text-white hover:bg-white/5 transition-colors" ActiveClass="bg-white/10 text-white font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                Favoritos
            </NavLink>
        </nav>
    </aside>

    <!-- AREA CENTRAL DE CONTENIDO -->
    <main class="flex-1 flex flex-col relative w-full h-full z-10">
        <!-- Espacio en bottom para no tapar contenido con los players -->
        <article class="flex-1 overflow-y-auto px-4 lg:px-8 pt-8 pb-32 lg:pb-32 w-full h-full">
            @Body
        </article>
    </main>

    <!-- REPRODUCTORES DE AUDIO -->
    <DesktopPlayer />
    <MiniPlayer />
    <ImmersivePlayer />

    <!-- BOTTOM NAV (Móvil / < lg) -->
    <nav class="lg:hidden fixed bottom-0 left-0 w-full bg-black/60 backdrop-blur-xl border-t border-white/10 flex justify-around items-center h-16 z-40 pb-safe">
        <NavLink href="" Match="NavLinkMatch.All" class="flex flex-col items-center justify-center w-full h-full text-gray-400 hover:text-white transition-colors" ActiveClass="text-white font-bold drop-shadow-md">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
        </NavLink>
        <NavLink href="buscar" class="flex flex-col items-center justify-center w-full h-full text-gray-400 hover:text-white transition-colors" ActiveClass="text-white font-bold drop-shadow-md">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </NavLink>
        <NavLink href="favoritos" class="flex flex-col items-center justify-center w-full h-full text-gray-400 hover:text-white transition-colors" ActiveClass="text-white font-bold drop-shadow-md">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        </NavLink>
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        PlayerState.OnStateChanged += HandleStateChanged;
        Favorites.OnFavoritesChanged += HandleStateChanged;
        await Favorites.InitializeAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PlayerState.OnStateChanged -= HandleStateChanged;
        Favorites.OnFavoritesChanged -= HandleStateChanged;
    }
}
