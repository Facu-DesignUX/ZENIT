@page "/favoritos"
@using ZENIT.Blazor.Components
@using ZENIT.Blazor.Services
@inject FavoritesService Favorites
@implements IDisposable

<PageTitle>Favoritos - ZENIT</PageTitle>

<div class="flex flex-col gap-6 w-full max-w-7xl mx-auto pb-10">
    <div class="flex items-center justify-between">
        <h1 class="text-4xl font-extrabold tracking-tight text-white drop-shadow-md flex items-center gap-3">
            Tus Favoritos
            <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </h1>
    </div>

    @if (!Favorites.IsInitialized)
    {
        <div class="flex flex-col items-center justify-center mt-20 opacity-50">
            <svg class="w-12 h-12 animate-spin text-zenit-primary mb-4" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p>Cargando tu bóveda...</p>
        </div>
    }
    else if (Favorites.Favorites.Any())
    {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-4 mt-6">
            @foreach (var station in Favorites.Favorites)
            {
                <RadioCard Station="station" PlaylistContext="Favorites.Favorites" />
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center mt-24 text-center">
            <div class="w-32 h-32 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mb-6 shadow-2xl">
                <svg class="w-16 h-16 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </div>
            <h3 class="text-3xl font-bold text-white mb-2">Aún no hay favoritos</h3>
            <p class="text-gray-400 max-w-md mx-auto text-lg">
                Tus estaciones guardadas aparecerán aquí. Explora el inicio o usa el buscador para descubrir nueva música.
            </p>
            <a href="buscar" class="mt-8 px-8 py-3 rounded-full bg-zenit-gradient text-white font-bold hover:scale-105 transition-transform shadow-lg shadow-zenit-primary/20">
                Explorar Estaciones
            </a>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Favorites.OnFavoritesChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Favorites.OnFavoritesChanged -= HandleStateChanged;
    }
}
