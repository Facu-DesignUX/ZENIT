@page "/"
@using ZENIT.Blazor.Components

<PageTitle>Inicio - ZENIT</PageTitle>

<div class="flex flex-col gap-8 pb-10 w-full max-w-7xl mx-auto px-2 md:px-6">

    <!-- SECCIÓN: HISPANOS -->
    <section class="mt-4">
        <h2 class="text-2xl font-bold text-white mb-4 px-1">Regiones Hispanohablantes 🌎</h2>
        <div class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory hide-scrollbar">
            <CategoryCard Title="Argentina" Emoji="🇦🇷" Link="/country/Argentina" BackgroundClass="bg-gradient-to-br from-blue-500 to-sky-400" />
            <CategoryCard Title="México" Emoji="🇲🇽" Link="/country/Mexico" BackgroundClass="bg-gradient-to-br from-green-500 to-emerald-600" />
            <CategoryCard Title="Colombia" Emoji="🇨🇴" Link="/country/Colombia" BackgroundClass="bg-gradient-to-br from-yellow-400 to-orange-500" />
            <CategoryCard Title="España" Emoji="🇪🇸" Link="/country/Spain" BackgroundClass="bg-gradient-to-br from-red-500 to-orange-600" />
            <CategoryCard Title="Chile" Emoji="🇨🇱" Link="/country/Chile" BackgroundClass="bg-gradient-to-br from-red-600 to-rose-700" />
            <CategoryCard Title="Perú" Emoji="🇵🇪" Link="/country/Peru" BackgroundClass="bg-gradient-to-br from-red-500 to-rose-600" />
            <CategoryCard Title="Uruguay" Emoji="🇺🇾" Link="/country/Uruguay" BackgroundClass="bg-gradient-to-br from-blue-400 to-cyan-500" />
        </div>
    </section>

    <!-- SECCIÓN: ANGLOPARLANTES Y GLOBAL -->
    <section>
        <h2 class="text-2xl font-bold text-white mb-4 px-1">Global y Habla Inglesa 🌍</h2>
        <div class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory hide-scrollbar">
            <CategoryCard Title="Estados Unidos" Emoji="🇺🇸" Link="/country/United States" BackgroundClass="bg-gradient-to-br from-blue-700 to-indigo-800" />
            <CategoryCard Title="Reino Unido" Emoji="🇬🇧" Link="/country/United Kingdom" BackgroundClass="bg-gradient-to-br from-red-700 to-blue-800" />
            <CategoryCard Title="Canadá" Emoji="🇨🇦" Link="/country/Canada" BackgroundClass="bg-gradient-to-br from-red-500 to-rose-700" />
            <CategoryCard Title="Australia" Emoji="🇦🇺" Link="/country/Australia" BackgroundClass="bg-gradient-to-br from-blue-600 to-indigo-700" />
            <CategoryCard Title="Francia" Emoji="🇫🇷" Link="/country/France" BackgroundClass="bg-gradient-to-br from-blue-500 to-red-500" />
            <CategoryCard Title="Italia" Emoji="🇮🇹" Link="/country/Italy" BackgroundClass="bg-gradient-to-br from-green-500 to-red-500" />
        </div>
    </section>

    <!-- SECCIÓN: GÉNEROS MUSICALES -->
    <section>
        <h2 class="text-2xl font-bold text-white mb-4 px-1">Géneros Musicales 🎵</h2>
        <div class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory hide-scrollbar">
            <CategoryCard Title="Reggaeton" Emoji="🔥" Link="/genre/reggaeton" BackgroundClass="bg-gradient-to-br from-purple-500 to-pink-500" />
            <CategoryCard Title="Pop" Emoji="✨" Link="/genre/pop" BackgroundClass="bg-gradient-to-br from-fuchsia-500 to-pink-600" />
            <CategoryCard Title="Rock" Emoji="🎸" Link="/genre/rock" BackgroundClass="bg-gradient-to-br from-zinc-700 to-black" />
            <CategoryCard Title="Electrónica" Emoji="⚡" Link="/genre/electronic" BackgroundClass="bg-gradient-to-br from-cyan-400 to-blue-600" />
            <CategoryCard Title="Hip Hop" Emoji="🎧" Link="/genre/hip hop" BackgroundClass="bg-gradient-to-br from-orange-500 to-red-600" />
            <CategoryCard Title="Jazz" Emoji="🎷" Link="/genre/jazz" BackgroundClass="bg-gradient-to-br from-amber-600 to-yellow-700" />
            <CategoryCard Title="Clásica" Emoji="🎻" Link="/genre/classical" BackgroundClass="bg-gradient-to-br from-slate-600 to-zinc-800" />
            <CategoryCard Title="Deportes" Emoji="⚽" Link="/genre/sports" BackgroundClass="bg-gradient-to-br from-green-400 to-emerald-600" />
            <CategoryCard Title="Noticias" Emoji="📰" Link="/genre/news" BackgroundClass="bg-gradient-to-br from-blue-600 to-indigo-800" />
        </div>
    </section>

</div>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

@code {
    // Las llamadas a la API ahora se hacen bajo demanda en CountryView.razor y GenreView.razor
}
